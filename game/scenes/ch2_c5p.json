      }
    },
    {
      "say": {
        "who": "Эрвин",
        "text": "Это ваше право. Я не обязан быть тем, кто вам нужен.",
        "expr": "soft"
      }
    },
    {
      "set": {
        "mentor": "hange",
        "trust": -1,
        "f_ch2_swap": true
      }
    },
    {
      "hide": "all"
    },
    {
